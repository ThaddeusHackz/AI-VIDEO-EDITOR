#!/usr/bin/env bash
# ============================================================================
#  bin/ai-video — Unified CLI for the AI-VIDEO-EDITOR Repository
#  Engines: HyperFrames + Remotion + REA + Higgsfield DoP + 47 Agent Skills
# ============================================================================
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CMD="${1:-doctor}"

bold() { printf "\033[1;36m%s\033[0m\n" "$1"; }
ok()   { printf "  \033[1;32m✓\033[0m %s\n" "$1"; }
warn() { printf "  \033[1;33m!\033[0m %s\n" "$1"; }

ensure_ffmpeg_from_remotion() {
  local comp_dir="${REPO_ROOT}/remotion/node_modules/@remotion/compositor-linux-x64-gnu"
  if ! command -v ffmpeg >/dev/null 2>&1 && [ -x "${comp_dir}/ffmpeg" ]; then
    sudo tee /usr/local/bin/ffmpeg >/dev/null <<EOF
#!/usr/bin/env bash
export LD_LIBRARY_PATH="${comp_dir}:\${LD_LIBRARY_PATH:-}"
exec "${comp_dir}/ffmpeg" "\$@"
EOF
    sudo tee /usr/local/bin/ffprobe >/dev/null <<EOF
#!/usr/bin/env bash
export LD_LIBRARY_PATH="${comp_dir}:\${LD_LIBRARY_PATH:-}"
exec "${comp_dir}/ffprobe" "\$@"
EOF
    sudo chmod +x /usr/local/bin/ffmpeg /usr/local/bin/ffprobe
  fi
}

case "$CMD" in
  setup)
    bold "== AI-VIDEO-EDITOR // Unified Toolchain Setup =="
    if ! command -v hyperframes >/dev/null 2>&1; then
      sudo npm i -g hyperframes --no-fund --no-audit
    fi
    ok "HyperFrames CLI $(hyperframes --version)"

    if [ ! -d "${REPO_ROOT}/remotion/node_modules/remotion" ]; then
      (cd "${REPO_ROOT}/remotion" && npm install --no-fund --no-audit)
    fi
    ensure_ffmpeg_from_remotion
    ok "Remotion dependencies & FFmpeg compositor ready"
    "$0" doctor
    ;;

  doctor)
    ensure_ffmpeg_from_remotion
    bold "== AI-VIDEO-EDITOR // System & Repository Doctor =="
    ok "Node.js        : $(node --version) ($(command -v node))"
    ok "npm            : $(npm --version)"
    if command -v ffmpeg >/dev/null 2>&1; then
      ok "FFmpeg         : $(ffmpeg -version 2>&1 | head -n 1)"
    else
      warn "FFmpeg         : not in PATH (run './bin/ai-video setup')"
    fi
    if command -v hyperframes >/dev/null 2>&1; then
      ok "HyperFrames CLI: $(hyperframes --version)"
    else
      warn "HyperFrames CLI: not in PATH (run './bin/ai-video setup')"
    fi
    if [ -d "${REPO_ROOT}/remotion/node_modules/remotion" ]; then
      REM_VER="$(node -p "require('${REPO_ROOT}/remotion/node_modules/remotion/package.json').version")"
      ok "Remotion       : v${REM_VER} (remotion/)"
    else
      warn "Remotion       : node_modules not installed yet (run './bin/ai-video setup')"
    fi
    SKILL_COUNT="$(find "${REPO_ROOT}/skills" -mindepth 1 -maxdepth 1 -type d | wc -l)"
    BLOCK_COUNT="$(find "${REPO_ROOT}/registry/blocks" -mindepth 1 -maxdepth 1 -type d | wc -l)"
    COMP_COUNT="$(find "${REPO_ROOT}/registry/components" -mindepth 1 -maxdepth 1 -type d | wc -l)"
    CACHE_COUNT="$(find "${REPO_ROOT}/.hyperframes/cache" -type f | wc -l)"
    REM_PKG_COUNT="$(find "${REPO_ROOT}/remotion/packages" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l)"
    ok "Agent Skills   : ${SKILL_COUNT} skills in skills/, .agents/skills/, .claude/skills/"
    ok "HyperFrames    : 15 packages + ${BLOCK_COUNT} blocks + ${COMP_COUNT} components (${CACHE_COUNT} cached manifests)"
    ok "Remotion Core  : ${REM_PKG_COUNT} upstream packages & templates in remotion/packages/ + 7 engine modules"
    ok "REA Engine     : ${REPO_ROOT}/rea (reverse-engineering & visual replication)"
    ok "Local Toolkit  : ${REPO_ROOT}/toolkit (fonts + GSAP + Three.js + Shaders + DoP + VFX Suite)"
    ;;

  verify)
    ensure_ffmpeg_from_remotion
    bold "== 1/3 Remotion TypeScript Verification (remotion/) =="
    (cd "${REPO_ROOT}/remotion" && npx tsc --noEmit)
    ok "Remotion TypeScript check passed (0 errors)"

    bold "== 2/3 HyperFrames Lint Verification (examples/ultrahigh-3d-vfx-showreel) =="
    hyperframes lint "${REPO_ROOT}/examples/ultrahigh-3d-vfx-showreel"
    ok "HyperFrames lint check passed (0 errors, 0 warnings)"

    bold "== 3/3 Seam-Stamp Vector Ledger Verification =="
    node "${REPO_ROOT}/scripts/seam-stamp.mjs" --ledger "${REPO_ROOT}/examples/ultrahigh-3d-vfx-showreel/ledger.json" >/dev/null
    ok "Vector Ledger (ledger.json) verified"
    ;;

  skills)
    bold "== AI-VIDEO-EDITOR // 47 Installed Agent Skills =="
    ls -1 "${REPO_ROOT}/skills"
    ;;

  presets)
    bold "== Higgsfield DoP Camera Presets (Remotion & HyperFrames) =="
    cat <<'EOF'
  1. dolly-zoom      — Vertigo z-push + counter-scale (subject locked, background warps)
  2. crash-zoom      — Aggressive snap-zoom into hero focal coordinate + Dutch roll
  3. orbit-360       — Smooth 3D orbital arc (rotateY + counter-rotateX + parallax)
  4. bullet-time     — Matrix speed-ramp freeze (100% -> 8% -> 100% timescale) + 3D orbit
  5. whip-pan        — Ultra-fast lateral pan with directional motion blur at cut boundary
  6. push-to-glass   — Macro Z-push through foreground glass plane into next scene
  7. crane-up        — High-angle vertical crane elevation with pitch tilt
  8. rack-focus      — Shallow DoF bokeh blur shift between foreground & background planes
  9. fpv-drone       — Banking S-curve aerial flythrough (roll + pitch + z-push)
 10. handheld-cinema — Organic seeded 24fps cinema camera shake (deterministic PRNG)

  Seam Craft Techniques (motion-doctrine / cut-the-curve):
  • cut-the-curve       — Exit power4.in -> Enter power4.out on matched X/Y vector
  • zoom-through        — Forward Z push (d(scale)/dt > 0 on both sides of cut)
  • inverse-zoom-through— Pull-back Z reveal (d(scale)/dt < 0 on both sides of cut)
  • waterfall-entry     — 2-phase linear scrub + expo.out settle staggered entry
  • nudge-curve         — 10% wind-up / 65% whip / 25% cushion group slide
EOF
    ;;

  compositions)
    bold "== Remotion Renderable Compositions (remotion/src/Root.tsx) =="
    cat <<'EOF'
  • Cinematic3D-Showcase    (1920x1080, 30fps, 240f / 8.0s)  — 3D Geodesic + Higgsfield DoP + Godrays
  • VFX-CGI-Compositor      (1920x1080, 30fps, 240f / 8.0s)  — 4-Pass VFX Breakdown + Bullet-Time Shatter
  • MotionDoctrine-Showreel (1920x1080, 30fps, 300f / 10.0s) — Waterfall + 7cqw Cursor + Cut-the-Curve + Climax
  • NLE-Master-Editor       (1920x1080, 30fps, 240f / 8.0s)  — Multi-Track NLE + Caption Rail/Embed + LUT Grade
  • ThaddeusTechz-Landscape (1920x1080, 30fps, 540f / 18.0s) — Channel Promo (16:9 Landscape)
  • ThaddeusTechz-Shorts    (1080x1920, 30fps, 540f / 18.0s) — Channel Promo (9:16 Vertical Shorts)
  • TitleCard               (1920x1080, 30fps, 180f / 6.0s)  — Prop-Driven Editorial Title Card
  • TitleCard-Square        (1080x1080, 30fps, 180f / 6.0s)  — Square Title Card Variant
  • ScriptureCard           (1920x1080, 30fps, 240f / 8.0s)  — Warm Minimalist Typography Card

  HyperFrames Reference Compositions:
  • examples/ultrahigh-3d-vfx-showreel (1920x1080, 30fps, 9.0s) — Lint-clean, Seam-Stamped 3D & DoP Showreel
EOF
    ;;

  *)
    echo "Usage: ./bin/ai-video {setup|doctor|verify|skills|presets|compositions}"
    exit 1
    ;;
esac
