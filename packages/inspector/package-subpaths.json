{
  "package": "@hyperframes/inspector",
  "subpaths": {
    ".": {
      "source": "./src/service.ts",
      "runtime": {
        "default": "./dist/service.js"
      },
      "types": "./dist/types/inspector/src/service.d.ts",
      "environments": ["bun", "node"]
    },
    "./live": {
      "runtime": {
        "default": "./dist/live.js"
      },
      "types": "./dist/types/inspector/src/live.d.ts",
      "environments": ["node"]
    }
  }
}
